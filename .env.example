# Copy this file to .env and fill in real values. Never commit the real .env.

# Shared secret configured on the GitHub organization webhook (Settings > Webhooks).
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=changeme-generate-a-long-random-string

# Bamboo personal access token (same one used for BAMBOO_TOKEN in ~/.secrets/bamboo.env).
BAMBOO_TOKEN=your-bamboo-personal-access-token

# Bamboo base URL - defaults to this if unset.
BAMBOO_BASE_URL=https://bamboo.local.shifamily.com

PORT=3000

# Optional: HTTP Basic Auth for the dashboard and /api/status (NOT the webhook or /healthz).
# Leave both unset/blank if this port is only reachable on a private network.
STATUS_USER=
STATUS_PASSWORD=
